// Banco PROPRIO deste servico (RFC-0004). Adicione os agregados do dominio
// abaixo. Sem outbox/dedup: a comunicacao com o OS Service e HTTP sincrono
// (RFC-0008); a idempotencia dos comandos e por numeroOS, no proprio agregado.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
