# Banco proprio deste servico (RFC-0004: nenhum servico acessa o banco de outro)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oficina_billing?schema=public"
# TLS no banco (RDS exige): true no EKS, vazio localmente
DB_SSL=
PORT=3001
# Segredo HS256 compartilhado com a Lambda de autenticacao (Secrets Manager em producao)
JWT_SECRET=change-me-to-a-strong-random-secret
# JWT_ISSUER=oficina-auth-lambda
LOG_LEVEL=debug

# Comunicacao HTTP com o OS Service (RFC-0008, docs/contratos/http-interno.md no hub):
# os callbacks deste servico vao para POST {OS_SERVICE_URL}/ordens-servico/{numero}/eventos.
# No cluster: http://oficina-app:3000 (Service `oficina-app`, namespace `oficina`). Em dev: o OS local.
OS_SERVICE_URL=http://localhost:3000

# APM (opcional)
DD_TRACE_ENABLED=false
DD_SERVICE=oficina-billing-service
